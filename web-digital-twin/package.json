{
    "name": "web-digital-twin",
    "version": "0.0.0",
    "private": true,
    "description": "A PlayCanvas React project",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:lan": "vite --host 0.0.0.0",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@gltf-transform/cli": "^4.5.0",
        "@gltf-transform/core": "^4.5.0",
        "@playcanvas/react": "^0.11.5",
        "@types/uuid": "^10.0.0",
        "playcanvas": "^2.22.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "uuid": "^14.0.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "@types/node": "^26.6.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/ui": "^5.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "vite": "^8.2.2",
        "vitest": "^5.0.1"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
